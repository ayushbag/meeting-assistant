NODE_ENV=development
PORT=3000
BASE_PATH=/api

JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

FRONTEND_ORIGIN=http://localhost:5000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meetinglens
REDIS_URL=redis://localhost:6379

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_SPEECH_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=meetinglens
RAG_SCORE_THRESHOLD=0.35
RAG_TOP_K=5

# Leave S3_ENDPOINT unset to use real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=meetinglens
S3_FORCE_PATH_STYLE=true

# Maximum completed object size in bytes (default: 524288000 = 500 MiB)
MAX_UPLOAD_BYTES=524288000
