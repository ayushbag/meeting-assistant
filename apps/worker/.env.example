NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meetinglens
REDIS_URL=redis://localhost:6379

# Gemini keys/models. Leave API key empty if you are not running AI jobs locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_SPEECH_MODEL=gemini-3.1-flash-lite
GEMINI_CLASSIFY_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Leave S3_ENDPOINT unset to use real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=meetinglens
S3_FORCE_PATH_STYLE=true

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=meetinglens
