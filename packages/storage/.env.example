# Local MinIO reference values. Storage is configured by the API and worker;
# this file documents the shared bucket settings used in development.
# Leave S3_ENDPOINT unset to use real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=meetinglens
S3_USE_SSL=false
